# Shopify Storefront API (Required)
# Read-only token used by the React frontend.
VITE_SHOPIFY_STOREFRONT_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Shopify Admin API (needed ONCE, to create the product catalog)
# The Storefront token above is READ-ONLY and cannot create products.
#
# PREFERRED — Dev Dashboard Client ID + secret (no long-lived token stored).
# Find both at Dev Dashboard -> your app -> Settings -> Credentials.
# The seeder exchanges them for a 24-hour token automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ALTERNATIVE — a static Admin API access token (shpat_...).
# Fill this in only if you are NOT using Client ID/secret above.
SHOPIFY_ADMIN_ACCESS_TOKEN=xxxxxxxx

# Analytics (Optional but recommended for CPC campaigns)
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads Conversion ID (AW-XXXXXXXXX) - for conversion tracking
VITE_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX

# Meta Pixel ID (Facebook Pixel) - for Meta Ads tracking
VITE_META_PIXEL_ID=123456789012345

# Optional: Custom domain for production
# VITE_SITE_URL=https://your-domain.com